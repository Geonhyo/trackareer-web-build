# 사이트 절대 URL — canonical·OG·sitemap에 쓰인다 (고정)
NEXT_PUBLIC_SITE_URL=https://www.trackareer.com

# 앱 API 서버 (계정 삭제 페이지가 직접 호출)
NEXT_PUBLIC_APP_API_URL=

# 카카오 JS SDK 앱 키 (로그인 목적 - 카카오디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 🔴 서버 KAKAO_WEB_REDIRECT_URI·카카오 콘솔 등록값과 문자열이 정확히 같아야 한다 
# (카카오디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키 상세 > 카카오 로그인 리다이렉트 URI)
NEXT_PUBLIC_KAKAO_REDIRECT_URI=


# 카카오 REST API 키 (계정 삭제 완료 화면의 "카카오 계정에서도 로그아웃" - 로그아웃 요청은 REST 키만 받는다)
# (카카오디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키) 비우면 버튼이 숨는다
# 로그아웃 후 사이트 홈으로 간다 - 콘솔 로그아웃 리다이렉트 URI에 NEXT_PUBLIC_KAKAO_REDIRECT_URI의 origin(끝 슬래시 없음)을 등록
NEXT_PUBLIC_KAKAO_REST_API_KEY=
