# 사이트 절대 URL — canonical·OG·sitemap에 쓰인다
NEXT_PUBLIC_SITE_URL=https://www.trackareer.com

# 앱 API 서버 (계정 삭제 페이지가 직접 호출)
NEXT_PUBLIC_APP_API_URL=https://app-api.trackareer.com

# 카카오 JS SDK 앱 키 (계정 삭제 페이지 로그인)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 🔴 서버 KAKAO_WEB_REDIRECT_URI·카카오 콘솔 등록값과 문자열이 정확히 같아야 한다
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://www.trackareer.com/account/delete
